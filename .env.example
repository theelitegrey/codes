# ---------------------------------------------------------------------------
# Shorts Director – environment configuration
# Copy to .env and fill in. Nothing here is required for `shorts doctor`.
# ---------------------------------------------------------------------------

# ---- LLM (agents: research, hooks, script, fact-check, visual director, QA) ----
# Anthropic API key. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
# Model used by the agents (default: claude-opus-5).
SHORTS_LLM_MODEL=claude-opus-5
# Model for the Motion Graphics Agent (default: claude-fable-5-1)
SHORTS_MOTION_MODEL=claude-fable-5-1

# ---- Voice provider -------------------------------------------------------
# voicestudio (default) | local
VOICE_PROVIDER=voicestudio

# VoiceStudio (https://voicestudio.sh) local backend. The desktop app / Docker
# image exposes an OpenAI-compatible API on port 3900 while it is running.
VOICESTUDIO_BASE_URL=http://localhost:3900
# Only needed when the backend is NOT on loopback (Docker on another host,
# Tailscale, reverse proxy). Loopback calls are unauthenticated by design.
# This is the value of OMNIVOICE_API_KEY on the backend; sent as a Bearer token.
VOICESTUDIO_API_KEY=
# Optional: VoiceStudio Share-PIN (X-OmniVoice-Pin header) for LAN sharing mode.
VOICESTUDIO_PIN=
# Timeout for a single speech generation request (ms). Long scripts take a while.
VOICESTUDIO_TIMEOUT_MS=600000

# ---- Avatar (speaking presenter) provider ---------------------------------
# longcat (default) | none
AVATAR_PROVIDER=longcat

# LongCat-Video-Avatar-1.5 has no hosted inference API. It runs as a local
# torchrun job from the meituan-longcat/LongCat-Video checkout.
# Execution mode: local | ssh | command
LONGCAT_EXEC_MODE=local
# Path to the cloned https://github.com/meituan-longcat/LongCat-Video repo
LONGCAT_REPO_DIR=/opt/LongCat-Video
# Checkpoint dir (huggingface-cli download meituan-longcat/LongCat-Video-Avatar-1.5 --local-dir <dir>)
# NOTE: the demo script also expects the base model at <checkpoint_dir>/../LongCat-Video
LONGCAT_CHECKPOINT_DIR=/opt/LongCat-Video/weights/LongCat-Video-Avatar-1.5
# Python interpreter of the conda env (python 3.10, torch 2.6 cu124, flash-attn)
LONGCAT_PYTHON=python
# Number of GPUs / context-parallel size (README examples use 2)
LONGCAT_NPROC=2
# 480p (832x480) or 720p (1280x768)
LONGCAT_RESOLUTION=480p
# Use INT8 quantized DiT to reduce VRAM (recommended)
LONGCAT_USE_INT8=true
# Optional: run on a remote GPU box over SSH (LONGCAT_EXEC_MODE=ssh)
LONGCAT_SSH_HOST=
LONGCAT_SSH_USER=
# Optional: fully custom command template (LONGCAT_EXEC_MODE=command)
# Placeholders: {input_json} {output_dir} {checkpoint_dir} {resolution} {num_segments}
LONGCAT_COMMAND_TEMPLATE=

# ---- Rendering --------------------------------------------------------------
# Path to ffmpeg / ffprobe binaries (default: from PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Output root for projects
SHORTS_OUTPUT_DIR=./output
# Optional: path to a Chromium/Chrome binary for Remotion (otherwise Remotion downloads its headless shell)
REMOTION_BROWSER_EXECUTABLE=

# ---- Illustration Agent (AI images / video) --------------------------------
# Model for the Illustration Agent (default: claude-fable-5-1)
SHORTS_ILLUSTRATION_MODEL=claude-fable-5-1
# Python env with torch + diffusers for local image/video generation (scripts/illustration/diffusers_generate.py)
ILLUSTRATION_PYTHON=python3
# Local VRAM in GB available to registry models (0 = no local GPU)
ILLUSTRATION_VRAM_GB=0
# Hugging Face token for the hf_inference adapter (text-to-image without a local GPU)
HF_TOKEN=
# Inference base URL (the endpoint moved to the router; confirm against current HF docs if you get 404s)
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference
# LongCat-Video base weights (text/image-to-video) for the longcat_video adapter
LONGCAT_VIDEO_CHECKPOINT_DIR=/opt/LongCat-Video/weights/LongCat-Video
# Local B-roll / image library searched by keywords before any AI generation
SHORTS_ASSET_DIR=

# ---- Captions Agent -----------------------------------------------------------
SHORTS_CAPTIONS_MODEL=claude-fable-5-1
# whisper.cpp install folder (Remotion's @remotion/install-whisper-cpp installs + downloads the model here)
WHISPER_CPP_DIR=
WHISPER_CPP_VERSION=1.7.4
# base.en | small.en | medium.en | large-v3-turbo ...
WHISPER_MODEL=base.en

# ---- Composer -------------------------------------------------------------------
SHORTS_COMPOSER_MODEL=claude-fable-5-1
