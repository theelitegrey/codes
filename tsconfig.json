{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "noUnusedLocals": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "remotion/**/*.ts", "remotion/**/*.tsx", "tests/**/*.ts"]
}
